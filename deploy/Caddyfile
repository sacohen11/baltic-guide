{$OBSERVATORY_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    reverse_proxy api:8000 {
        flush_interval -1
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
}
