# Copy to .env. Values below run a local, credential-free illustrative demo.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/baltic.db
TRANSPORT=local
EMBEDDED_RUNTIME=true
WORKERS=4
PUBLIC_URL=http://localhost:8000
ENABLE_CONNECTORS=false
SOURCES_FILE=config/sources.yaml

# Production: DEMO_MODE=false and set a unique random token (minimum 24 characters).
ADMIN_TOKEN=
POSTGRES_PASSWORD=

# Optional OpenAI-compatible chat-completion endpoint. No model is needed for deterministic mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_TOKEN_BUDGET=200000

KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_REPLICATION_FACTOR=1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_CA_FILE=/run/secrets/kafka-ca.pem

# Obtain approved access and configure field_map in config/sources.yaml.
VISIT_ESTONIA_API_URL=
VISIT_ESTONIA_API_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
