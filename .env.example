# No synthetic feed. Obtain GCN credentials at https://gcn.nasa.gov/quickstart
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=
# Keep stable across restarts; choose a different group for independent installations.
GCN_GROUP_ID=space-observatory-v1
GCN_AUTO_OFFSET_RESET=latest
# Empty subscribes to every supported topic in backend/observatory/registry.py.
GCN_TOPICS=

# Generate separately with: openssl rand -hex 32
ADMIN_TOKEN=
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://sacohen11.github.io
OBSERVATORY_DOMAIN=localhost

# Configure both for LLM reasoning. Without them, source ingestion and deterministic
# evidence briefings still work; the UI explicitly reports evidence mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_TOKEN_BUDGET=200000

WORKERS=4
TRANSPORT=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_REPLICATION_FACTOR=1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
EMBEDDED_RUNTIME=false
# Compose supplies PostgreSQL automatically. For non-Compose use:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/observatory
# External internal-cluster authentication, if using managed Kafka:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_CA_FILE=/run/secrets/kafka-ca.pem
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
