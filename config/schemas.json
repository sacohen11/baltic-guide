{
  "Observation": {
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "message_id": {
        "maxLength": 128,
        "title": "Message Id",
        "type": "string"
      },
      "source_id": {
        "maxLength": 120,
        "minLength": 1,
        "title": "Source Id",
        "type": "string"
      },
      "source_item_id": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Source Item Id",
        "type": "string"
      },
      "entity_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Entity Id"
      },
      "title": {
        "maxLength": 500,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "summary": {
        "default": "",
        "maxLength": 20000,
        "title": "Summary",
        "type": "string"
      },
      "source_url": {
        "title": "Source Url",
        "type": "string"
      },
      "country": {
        "enum": [
          "lv",
          "ee",
          "lt"
        ],
        "title": "Country",
        "type": "string"
      },
      "city_ids": {
        "items": {
          "type": "string"
        },
        "maxItems": 30,
        "title": "City Ids",
        "type": "array"
      },
      "candidate_city_ids": {
        "items": {
          "type": "string"
        },
        "maxItems": 30,
        "title": "Candidate City Ids",
        "type": "array"
      },
      "language": {
        "default": "en",
        "maxLength": 12,
        "title": "Language",
        "type": "string"
      },
      "kind": {
        "default": "news",
        "enum": [
          "event",
          "news",
          "disruption",
          "weather",
          "closure"
        ],
        "title": "Kind",
        "type": "string"
      },
      "status": {
        "default": "active",
        "enum": [
          "scheduled",
          "active",
          "cancelled",
          "postponed",
          "expired"
        ],
        "title": "Status",
        "type": "string"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "title": "Tags",
        "type": "array"
      },
      "starts_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Starts At"
      },
      "ends_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ends At"
      },
      "published_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Published At"
      },
      "updated_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Updated At"
      },
      "observed_at": {
        "format": "date-time",
        "title": "Observed At",
        "type": "string"
      },
      "timezone": {
        "default": "Europe/Riga",
        "title": "Timezone",
        "type": "string"
      },
      "location": {
        "anyOf": [
          {
            "maxLength": 500,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Location"
      },
      "verification": {
        "default": "source_reported",
        "enum": [
          "source_reported",
          "organizer_confirmed",
          "needs_verification"
        ],
        "title": "Verification",
        "type": "string"
      },
      "authoritative": {
        "default": false,
        "title": "Authoritative",
        "type": "boolean"
      },
      "illustrative": {
        "default": false,
        "title": "Illustrative",
        "type": "boolean"
      },
      "trace_id": {
        "title": "Trace Id",
        "type": "string"
      },
      "replay": {
        "default": false,
        "title": "Replay",
        "type": "boolean"
      }
    },
    "required": [
      "source_id",
      "source_item_id",
      "title",
      "source_url",
      "country"
    ],
    "title": "Observation",
    "type": "object"
  },
